# Copy to .env and fill in. All apps read the root .env.

# Postgres (docker-compose.yaml)
POSTGRES_USER=rbtw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=read_between_the_wines

DATABASE_URL=postgresql://rbtw:change-me@localhost:5432/read_between_the_wines

# Better Auth: signs cookies and tokens. Generate a secret with
#   openssl rand -base64 32
# BETTER_AUTH_URL is the origin the browser sees (Vite proxies /api to the backend).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4200

# Outgoing email. Locally it goes to Mailpit (inbox at http://localhost:8025)
# over SMTP; these defaults point there. In production (NODE_ENV=production)
# the SMTP_* settings are ignored and email goes through Resend's API, which
# needs RESEND_API_KEY. EMAIL_FROM is used by both.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Read Between the Wines <no-reply@readbetweenthewines.local>"

# Production only. Leave empty locally.
RESEND_API_KEY=

# Where uploaded photos go. Optional: defaults to uploads/ in the repo root
# (gitignored). On Railway it's the volume's mount path.
UPLOAD_DIR=
