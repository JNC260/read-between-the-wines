# Copy to .env and fill in. All apps read the root .env.

# Postgres (docker-compose.yaml)
POSTGRES_USER=rbtw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=read_between_the_wines

DATABASE_URL=postgresql://rbtw:change-me@localhost:5432/read_between_the_wines

# Better Auth: signs cookies and tokens. Generate a secret with
#   openssl rand -base64 32
# BETTER_AUTH_URL is the origin the browser sees (Vite proxies /api to the backend).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4200

# Outgoing email. These defaults point at Mailpit (inbox at http://localhost:8025).
# For production, use your provider's SMTP settings: usually port 587 with
# SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Read Between the Wines <no-reply@readbetweenthewines.local>"
