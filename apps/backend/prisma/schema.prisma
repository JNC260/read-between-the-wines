generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  active       Boolean  @default(true)
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  status UserStatus @default(ACTIVE) 

  suggestions Suggestion[]
  ratings     Rating[]
  votes       Vote[]
}

model Book {
  id            String   @id @default(uuid())
  title         String
  author        String
  yearPublished Int?
  genres        String[]
  coverUrl      String?
  createdAt     DateTime @default(now())

  suggestions Suggestion[]
  ratings     Rating[]
  meeting     Meeting?
  polls       Poll[]
  votes       Vote[]
}

// join table: User <-> Book
model Suggestion {
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@id([userId, bookId])
}

// join table: User <-> Book, carrying a score (1-5, validated with Zod)
model Rating {
  userId    String
  bookId    String
  score     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@id([userId, bookId])
}

model Venue {
  id            String @id @default(uuid())
  name          String
  streetAddress String
  city          String
  state         String
  zip           String

  meetings Meeting[]
}

model Meeting {
  id          String   @id @default(uuid())
  start       DateTime
  end         DateTime
  description String?
  venueId     String
  bookId      String?  @unique // one book per meeting; null until a book is assigned

  venue Venue @relation(fields: [venueId], references: [id])
  book  Book? @relation(fields: [bookId], references: [id])
}

model Poll {
  id             String   @id @default(uuid())
  theme          String?
  opensAt        DateTime
  closesAt       DateTime
  votesPerMember Int      @default(2)
  createdAt      DateTime @default(now())

  books Book[] // the ballot (implicit many-to-many)
  votes Vote[]
}

// one row per book a member picks on a ballot; resubmitting replaces them
model Vote {
  userId    String
  pollId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  poll Poll @relation(fields: [pollId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@id([userId, pollId, bookId])
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

// join table: User <-> Meeting
model Rsvp {
  userId     String
  meetingId  String
  status     RsvpStatus
  guestCount Int        @default(0)
  dish       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@id([userId, meetingId])
}