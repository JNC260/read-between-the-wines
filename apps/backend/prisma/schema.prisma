generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

// Better Auth's user table. name, emailVerified and image are its core
// fields; firstName, lastName, status and isAdmin are registered as
// additionalFields in src/lib/auth.ts. Passwords live on Account.
// The profile fields after isAdmin are ours alone; Better Auth never reads
// them. Every member can see them, so they're optional.
model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  firstName     String
  lastName      String
  isAdmin       Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  phone         String? // E.164, e.g. "+15551234567"
  facebookUrl   String?
  goodreadsUrl  String?
  instagram     String? // handles, without the @
  tiktok        String?
  x             String?
  venmo         String?
  memberSince   Int? // the year they joined the club, which for most is before the site existed
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions    Session[]
  accounts    Account[]
  suggestions Suggestion[]
  ratings     Rating[]
  votes       Vote[]
  rsvps       Rsvp[]
  invitesSent Invite[]
}

// Better Auth: one row per signed-in browser
model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Better Auth: one row per way a user can sign in. For email and password,
// providerId is "credential" and password holds the hash.
model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Sign-up is invite-only. A member shares a one-use link carrying a random
// token; only its SHA-256 hash is stored, so a database leak doesn't expose
// usable links. Not tied to an email: the invitee verifies their own.
model Invite {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String? // null when created by the create-admin script
  createdAt   DateTime  @default(now())

  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)
}

// Better Auth: short-lived tokens, like email verification links
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Book data comes from Open Library (looked up from a pasted Goodreads link)
// or from the manual form. Open Library groups every edition of a book under
// one work, so openLibraryWorkId is what stops duplicates; manual entries
// have no work id and are checked against normalizedTitle in app code.
model Book {
  id                String   @id @default(uuid())
  title             String
  normalizedTitle   String // set by books.service via normalizeTitle(); never written directly
  author            String
  yearPublished     Int?
  genres            String[]
  coverUrl          String?
  synopsis          String?
  pageCount         Int?
  openLibraryWorkId String?  @unique // e.g. "OL18012166W"
  goodreadsUrl      String? // Goodreads ids are per edition, so not unique
  createdAt         DateTime @default(now())

  suggestions Suggestion[]
  ratings     Rating[]
  meeting     Meeting?
  polls       Poll[]
  votes       Vote[]

  @@index([normalizedTitle])
}

// join table: User <-> Book
model Suggestion {
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@id([userId, bookId])
}

// join table: User <-> Book, carrying a score (1-5, validated with Zod)
model Rating {
  userId    String
  bookId    String
  score     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@id([userId, bookId])
}

model Venue {
  id            String @id @default(uuid())
  name          String
  streetAddress String
  city          String
  state         String
  zip           String

  meetings Meeting[]
}

model Meeting {
  id          String   @id @default(uuid())
  title       String
  start       DateTime
  end         DateTime
  description String?
  craft       String? // what we're making, and anything to bring for it
  venueId     String? // null until a venue is picked
  bookId      String?  @unique // one book per meeting; null until a book is assigned

  venue Venue? @relation(fields: [venueId], references: [id])
  book  Book?  @relation(fields: [bookId], references: [id])
  rsvps Rsvp[]
}

model Poll {
  id             String   @id @default(uuid())
  theme          String?
  opensAt        DateTime
  closesAt       DateTime
  votesPerMember Int      @default(2)
  createdAt      DateTime @default(now())

  books Book[] // the ballot (implicit many-to-many)
  votes Vote[]
}

// one row per book a member picks on a ballot; resubmitting replaces them
model Vote {
  userId    String
  pollId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  poll Poll @relation(fields: [pollId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@id([userId, pollId, bookId])
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

// join table: User <-> Meeting
model Rsvp {
  userId     String
  meetingId  String
  status     RsvpStatus
  guestCount Int        @default(0)
  dish       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@id([userId, meetingId])
}
